{
  "name": "cs3604-12306-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "sqlite3"
    ]
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/backend/test/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setupEnv.js",
      "<rootDir>/test/setup.js"
    ],
    "verbose": false
  }
}
